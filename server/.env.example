# ===== Stella Web IM backend configuration =====
# All values have safe defaults; this file is optional.

# --- HTTP ---
PORT=3001
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173

# --- MySQL ---
DB_HOST=127.0.0.1
DB_PORT=3308
DB_USER=root
DB_PASSWORD=123456
DB_NAME=stella_im
DB_POOL=10

# --- JWT ---
JWT_ACCESS_SECRET=stella-im-access-secret-dev
JWT_REFRESH_SECRET=stella-im-refresh-secret-dev
ACCESS_TTL_SEC=900
REFRESH_TTL_SEC=604800

# --- WebSocket ---
WS_HEARTBEAT_MS=25000
WS_AUTH_CHECK_MS=60000

# --- System notice ---
SYSTEM_NOTICE_MS=120000
SYSTEM_NOTICE_ENABLED=true
