# Frontend runtime configuration (copy to .env.local to override defaults).
#
# By default the app is served SAME-ORIGIN with the API: in dev the Vite server
# proxies `/api` and `/ws` to the backend, so the HttpOnly refresh cookie is a
# first-party cookie. Set VITE_API_BASE only when the backend genuinely lives on
# a different origin (this also re-enables cross-origin CORS).
# VITE_API_BASE=http://localhost:3001

# Optional explicit WebSocket endpoint override
# VITE_WS_URL=ws://localhost:3001/ws

# Backend the Vite dev/preview server proxies to.
# VITE_API_PROXY_TARGET=http://127.0.0.1:3001
