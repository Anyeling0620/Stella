# Frontend runtime configuration (copy to .env.local to override defaults)

# Base URL of the Stella IM backend. The WebSocket URL and the polling URL are
# derived from it automatically (http -> ws).
VITE_API_BASE=http://127.0.0.1:3001

# Optional explicit WebSocket endpoint override
# VITE_WS_URL=ws://127.0.0.1:3001/ws
